# Database — SQLite file, created by `npm run db:migrate -w api`. Tests use ':memory:'.
DATABASE_URL=./finch.db

# API
PORT=3000

# Frontend (for reference)
VITE_API_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT — optional in development (falls back to a dev secret so the app runs with
# no setup). Required in production: use a cryptographically random string.
JWT_SECRET=workshop-dev-secret-change-in-production
